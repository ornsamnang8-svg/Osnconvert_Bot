# ==============================================================================
# Link2Media Telegram Bot - Configuration File
# Copy this file to .env and fill in your values.
# ==============================================================================

# Required: Telegram Bot Token obtained from @BotFather
# Example: BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ123456789
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Optional: Restrict bot usage to specific numeric Telegram user IDs (comma-separated).
# Leave empty to allow any user who starts a private chat with the bot.
# Example: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# Media Limits
# Maximum video duration in seconds (default: 1200 = 20 minutes)
MAX_DURATION_SECONDS=1200

# Maximum final file upload size to Telegram in bytes
# (Telegram's public Bot API limit is 50 MB; 48,000,000 bytes leaves safe margin for metadata)
MAX_UPLOAD_BYTES=48000000

# Concurrency & Queue Limits
# Maximum simultaneous download/conversion jobs running globally
MAX_CONCURRENT_JOBS=2

# Maximum jobs waiting in queue before rejecting new submissions
MAX_QUEUE_SIZE=10

# Status Message Throttling (seconds between edits to avoid Telegram rate limits)
STATUS_UPDATE_INTERVAL=3.0

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Explicit paths to binaries (only needed if not in PATH or virtualenv)
# FFMPEG_PATH=
# FFPROBE_PATH=
# DENO_PATH=
